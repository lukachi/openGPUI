root = Stack([intro, layoutCard, contentCard, imagesCard, tablesCard, charts2dCard, charts1dCard, formsCard, buttonsCard, dataCard, cardsCard, modal])
intro = CardHeader("openGPUI gallery", "Every component of OpenUI's openui library, grouped as the library groups them (Slice has no place an OpenUI file can use it). Chat-only components: gallery-chat.oui.")

$showModal = false
$liked = false

layoutCard = Card([CardHeader("Layout", "Tabs, Accordion, Steps, Carousel, Separator, Modal"), tabs, Separator(), accordion, Separator(), steps, Separator(), carousel, Separator(), Buttons([Button("Open the modal", Action([@Set($showModal, true)]), "secondary")])])
tabs = Tabs([TabItem("one", "Overview", [TextContent("First tab. A complete response opens on its last tab, as upstream does.")]), TabItem("two", "Details", [TextContent("Second tab with **markdown**.")]), TabItem("three", "Numbers", [TagBlock(["alpha", "beta", "gamma"])])])
accordion = Accordion([AccordionItem("a", "What is openGPUI?", [TextContent("OpenUI Lang drawn with native gpui elements.")]), AccordionItem("b", "Where does it run?", [TextContent("In Herdr, as a mod.")])])
steps = Steps([StepsItem("Write the file", "The agent writes a `.oui` file."), StepsItem("Show it", "`opengpui show file.oui --tab`"), StepsItem("Act", "Clicks come back to the agent.")])
carousel = Carousel([[CardHeader("Slide 1", "card variant")], [CardHeader("Slide 2", "scroll sideways")], [CardHeader("Slide 3", "or use the arrows")], [CardHeader("Slide 4", "")], [CardHeader("Slide 5", "")]], "card")
modal = Modal("A modal", $showModal, [TextContent("It covers the pane. Close with X, Escape or a click on the backdrop."), Buttons([Button("Close", Action([@Set($showModal, false)]), "primary")])], "md")

contentCard = Card([CardHeader("Content", "Card, CardHeader, TextContent, MarkDownRenderer, Callout, TextCallout, CodeBlock, InlineHeader"), InlineHeader("InlineHeader", "A compact heading with a description"), TextContent("TextContent in **large-heavy**", "large-heavy"), TextContent("TextContent default with *italic*, `code` and a [link](https://openui.com)."), MarkDownRenderer("## MarkDownRenderer\n\n- a list item\n- another\n\n> a quote\n\n```ts\nconst x: number = 42;\n```", "card"), Callout("info", "Callout info", "Something to know."), Callout("success", "Callout success", "All good."), Callout("warning", "Callout warning", "Check this."), Callout("error", "Callout error", "Something failed."), TextCallout("info", "TextCallout", "A text callout with a left border."), CodeBlock("python", "def hello(name):\n    return f\"Hello, {name}\"")])

imagesCard = Card([CardHeader("Images", "Image, ImageBlock, ImageGallery"), Stack([Image("A fjord", "https://picsum.photos/id/1015/600/400"), Image("Mountains", "https://picsum.photos/id/1018/600/400"), Image("Broken image", "https://example.invalid/missing.png")], "row"), ImageBlock("https://picsum.photos/id/1043/800/500", "A lake"), ImageGallery([{src: "https://picsum.photos/id/1011/600/400", alt: "One"}, {src: "https://picsum.photos/id/1016/600/400", alt: "Two"}, {src: "https://picsum.photos/id/1019/600/400", alt: "Three"}, {src: "https://picsum.photos/id/1020/600/400", alt: "Four"}, {src: "https://picsum.photos/id/1021/600/400", alt: "Five"}, {src: "https://picsum.photos/id/1022/600/400", alt: "Six"}])])

tablesCard = Card([CardHeader("Tables", "Table, Col, EditableTable"), Table([Col("Service", ["auth", "billing-api", "search", "ingest"]), Col("State", ["ready", "blocked", "ready", "ready"]), Col("p95 ms", [120, 340, 95, 210], "number")]), EditableTable("roster", [{type: "text", key: "name", header: "Name"}, {type: "select", key: "role", header: "Role", options: [{value: "eng", label: "Engineering"}, {value: "design", label: "Design"}, {value: "product", label: "Product"}]}, {type: "date-single", key: "start", header: "Start Date"}, {type: "number", key: "score", header: "Score"}, {type: "url", key: "site", header: "Site"}], [{id: "1", values: ["Alex Kim", "eng", "2024-01-15", 42, "https://example.com"]}, {id: "2", values: ["Sam Lee", "design", "2024-03-01", 37, "https://openui.com"]}])])

charts2dCard = Card([CardHeader("Charts (2D)", "BarChart, LineChart, AreaChart, HorizontalBarChart, RadarChart, Series"), BarChart(months, [Series("Desktop", [186, 305, 237, 73, 209, 214]), Series("Mobile", [80, 200, 120, 190, 130, 140])], "grouped"), LineChart(months, [Series("Visitors", [120, 180, 150, 210, 190, 240])], "natural"), AreaChart(months, [Series("Sales", [30, 45, 40, 60, 55, 70]), Series("Returns", [5, 8, 6, 9, 7, 10])], "natural"), HorizontalBarChart(["Search", "Billing", "Auth", "Ingest"], [Series("Requests", [420, 310, 280, 150])]), RadarChart(["Speed", "Quality", "Price", "Support", "Docs"], [Series("Us", [8, 7, 6, 9, 7]), Series("Them", [6, 8, 7, 5, 6])])])
months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]

charts1dCard = Card([CardHeader("Charts (1D, Scatter)", "PieChart, RadialChart, SingleStackedBarChart, ScatterChart, ScatterSeries, Point"), PieChart(["Chrome", "Safari", "Firefox", "Edge"], [62, 20, 10, 8]), PieChart(["Done", "In progress", "Todo"], [12, 5, 3], "donut", "semiCircular"), RadialChart(["Q1", "Q2", "Q3", "Q4"], [40, 65, 50, 80]), SingleStackedBarChart(["Used", "Reserved", "Free"], [55, 20, 25]), ScatterChart([ScatterSeries("Team A", [Point(1, 2), Point(2, 4), Point(3, 3), Point(4, 6)]), ScatterSeries("Team B", [Point(1, 5), Point(2, 3), Point(3, 6), Point(4, 4)])], "Hours", "Output")])

formsCard = Card([CardHeader("Forms", "Form, FormControl, Label, Input, TextArea, Select, DatePicker, Slider, CheckBoxGroup, RadioGroup, SwitchGroup, Chips, OptionCards"), Label("A standalone Label"), form])
form = Form("signup", formButtons, [fName, fBio, fPlan, fWhen, fRange, fSeats, fTopics, fShip, fChips, fTrip, fAlerts])
formButtons = Buttons([Button("Submit", @ToAssistant("Submit the form"), "primary"), Button("Cancel", @ToAssistant("Cancel"), "secondary")])
fName = FormControl("Name", Input("name", "Your name", "text", {required: true}), "As on your badge")
fBio = FormControl("Bio", TextArea("bio", "Tell us more", 3))
fPlan = FormControl("Plan", Select("plan", [SelectItem("free", "Free"), SelectItem("pro", "Pro"), SelectItem("team", "Team")], "Choose a plan"))
fWhen = FormControl("Start date", DatePicker("start"))
fRange = FormControl("Trip dates", DatePicker("trip", "range"))
fSeats = FormControl("Seats", Slider("seats", "continuous", 1, 50, 1, [5], "Seats"))
fTopics = FormControl("Topics", CheckBoxGroup("topics", [CheckBoxItem("Engineering", "Build things", "eng", true), CheckBoxItem("Design", "Make it nice", "design"), CheckBoxItem("Product", "Decide what", "product")]))
fShip = FormControl("Shipping", RadioGroup("shipping", [RadioItem("Standard", "3-5 days", "standard"), RadioItem("Express", "Next day", "express")], "standard"))
fChips = FormControl("Tools", Chips("tools", "multiple", [ChipItem("slack", "Slack", Icon("message-square")), ChipItem("github", "GitHub", Icon("github")), ChipItem("linear", "Linear"), ChipItem("jira", "Jira", null, true)]))
fTrip = FormControl("Trip type", OptionCards("tripType", "single", [OptionCard("city", "City break", "Museums and food", Icon("building")), OptionCard("nature", "Nature", "Hikes and lakes", Icon("trees")), OptionCard("beach", "Beach", "Sun and sea", Icon("sun"))]))
fAlerts = FormControl("Alerts", SwitchGroup("alerts", [SwitchItem("Mentions", "When someone mentions you", "mentions", true), SwitchItem("Replies", "Replies to your threads", "replies")], "card"))

buttonsCard = Card([CardHeader("Buttons", "Button, Buttons, IconButton"), Buttons([Button("Primary", @ToAssistant("primary"), "primary"), Button("Secondary", @ToAssistant("secondary"), "secondary"), Button("Tertiary", @ToAssistant("tertiary"), "tertiary"), Button("Delete", @ToAssistant("delete"), "secondary", "destructive"), Button("Small", @ToAssistant("small"), "primary", "normal", "small")]), Buttons([IconButton("Like", Icon("heart"), Action([@Set($liked, true)]), "secondary"), IconButton("Settings", Icon("settings"), @ToAssistant("settings"), "tertiary"), IconButton("Add", Icon("plus"), @ToAssistant("add"), "primary", "medium", "circle"), IconButton("Docs", Icon("external-link"), @OpenUrl("https://openui.com"), "secondary", "small")])])

dataCard = Card([CardHeader("Data display", "Tag, TagBlock, Icon, EntityList, ListBlock, ListItem"), Stack([Tag("neutral"), Tag("info", Icon("info"), "sm", "info"), Tag("success", null, "sm", "success"), Tag("warning", null, "md", "warning"), Tag("danger", null, "lg", "danger"), Icon("rocket")], "row", "s", "center"), TagBlock(["typescript", "gpui", "herdr", "openui"], "md"), EntityList([{left: "Plan", right: "Pro"}, {left: "Seats", right: "12", rightVariant: "number"}, {left: "Renews", right: "Dec 1"}], "default", {left: "Item", right: "Value"}, {left: "Total", right: "$240", rightVariant: "number"}), ListBlock([ListItem("Read the docs", "openui.com", null, "Open", @OpenUrl("https://openui.com")), ListItem("Try a form", "Fill the Forms card above", null, "Go", @ToAssistant("Try a form")), ListItem("Plain item", "No action")], "number")])

cardsCard = Card([CardHeader("Cards", "Snippet, Overview, Context, Visual, Composite card blocks; Text, BoldText, IconText, ImageText, ImageTextLarge, MetricIndicatorInline, MetricIndicatorWithStrikethrough"), snippets, overview, context, visual, composite])
snippets = SnippetCardBlock([SnippetCardItem("users", IconText(Icon("users"), "info", "m", "Users", "Active this week"), BoldText("number", "1,204")), SnippetCardItem("rev", IconText(Icon("dollar-sign"), "success", "m", "Revenue", "This month"), Text("number", "$48,200", "+4.1%", "metric")), SnippetCardItem("ada", ImageText("https://picsum.photos/id/1027/200/200", "Ada", "Ada Lovelace", "Owner"), Text("text", "Admin"))], "grid", true, @ToAssistant("Open this fact"))
overview = OverviewCardBlock([OverviewCardItem("o1", IconText(Icon("activity"), "info", "m", "Uptime", null, false, "vertical"), MetricIndicatorInline("99.9%", "last 30 days", {direction: "up", value: 0.2})), OverviewCardItem("o2", IconText(Icon("zap"), "warning", "m", "Latency", null, false, "vertical"), MetricIndicatorInline("212 ms", "p95", {direction: "down", value: 3.5})), OverviewCardItem("o3", Text("text", "Errors"), MetricIndicatorInline("0.4%", "of requests"))], "grid")
context = ContextCardBlock([ContextCardItem("c1", "Spring", "Blooming season", "gray"), ContextCardItem("c2", Tag("Autumn", null, "sm", "warning"), "Leaves fall"), ContextCardItem("c3", "Lake", "A background image", null, "https://picsum.photos/id/1036/600/400", "A lake")], "grid")
visual = VisualCardBlock([VisualCardItem(BoldText("text", "Fjords", "Norway"), "v1", "https://picsum.photos/id/1015/600/600", Tag("Trip", null, "sm", "info")), VisualCardItem(BoldText("text", "Peaks", "Alps"), "v2", "https://picsum.photos/id/1018/600/600", Tag("Hike", null, "sm", "success"))], "grid")
composite = CompositeCardBlock([CompositeCardItem("p1", IconText(Icon("package"), "info", "m", "Starter", "For small teams"), [MetricIndicatorInline("$12", "per seat"), BarChart(["W1", "W2", "W3", "W4"], [Series("Usage", [3, 5, 4, 7])]), TagBlock(["5 seats", "Email support"], "sm")], {price: MetricIndicatorWithStrikethrough("$12", "per month", "$15", {direction: "down", value: 20}), button: Button("Choose", @ToAssistant("Choose Starter"), "primary")}), CompositeCardItem("p2", ImageTextLarge("https://picsum.photos/id/1039/800/300", "Banner", "Pro", "For growing teams"), [EntityList([{left: "Seats", right: "50"}, {left: "Support", right: "24/7"}], "small"), ListBlock([ListItem("SSO"), ListItem("Audit log")], "number", "small")], {price: BoldText("number", "$49"), button: Button("Choose", @ToAssistant("Choose Pro"), "secondary")})], "grid")
