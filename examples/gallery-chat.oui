root = Card([CardHeader("openGPUI chat gallery", "Components only the chat library has: SectionBlock/SectionItem and FollowUpBlock/FollowUpItem"), sections, ListBlock([ListItem("Open the docs", "openui.com", null, "Open", @OpenUrl("https://openui.com")), ListItem("Plain item", "No action")], "number"), followUps])
sections = SectionBlock([SectionItem("intro", "Introduction", [TextContent("Sections open as they stream in; when the response is complete only the first stays open.")]), SectionItem("data", "Data", [Table([Col("Name", ["auth", "search"]), Col("p95", [120, 95], "number")])]), SectionItem("notes", "Notes", [Callout("info", "A note", "Click a trigger to fold or unfold.")])])
followUps = FollowUpBlock([FollowUpItem("Tell me more about Python"), FollowUpItem("Compare it with TypeScript"), FollowUpItem("Show an example")])
