root = Stack([header, tabs])
header = CardHeader("How openGPUI works", "Three diagrams. Pick a step to light up its part; click a box to ask me about it.")
tabs = Tabs([bigTab, paneTab, shipTab])
bigTab = TabItem("big", "The big picture", [bigTitle, bigIntro, big, bigNote])
paneTab = TabItem("pane", "Inside the pane", [paneTitle, paneIntro, pane, paneNote])
shipTab = TabItem("ship", "Build and ship", [shipTitle, shipIntro, ship, shipNote])

bigTitle = InlineHeader("From the agent's file to your click and back")
bigIntro = MarkDownRenderer("openGPUI lets a coding agent show you native UI in a Herdr pane and get your answer back. Two processes take part: the agent's terminal (where the CLI runs) and the Herdr app (where the pane draws). They talk only through herdr-core and files.")
big = Diagram(bigNodes, bigEdges, bigSteps, "right")
bigNodes = [Node("person", "You", "actor"), terminal, app, files, Node("hc", "herdr-core", "process", "hc: panes, send"), Node("web", "Web", "external", "images, links")]
terminal = Group("terminal", "Agent terminal (Node / Bun)", [Node("agent", "Coding agent", "actor", "omp, Claude Code, Codex"), Node("skill", "Agent skill", "file", "SKILL.md"), Node("cli", "opengpui CLI", "process", "check, show, wait")])
app = Group("app", "Herdr app (QuickJS)", [Node("mod", "opengpui mod", "process", "main.js + shared.js"), Node("core", "Core library", "module", "Session, Surface")])
files = Group("files", "Files on disk", [Node("oui", "review.oui", "file"), Node("events", "Events log", "store", "jsonl")])
bigEdges = [Edge("agent", "oui", "writes"), Edge("agent", "cli", "check, show, wait"), Edge("skill", "agent", "teaches"), Edge("cli", "core", "parses (headless)"), Edge("cli", "events", "empties, reads"), Edge("cli", "hc", "pane.split"), Edge("hc", "mod", "opens pane"), Edge("mod", "oui", "reads, watches"), Edge("mod", "core", "parse, draw"), Edge("person", "mod", "clicks"), Edge("mod", "events", "appends event"), Edge("mod", "hc", "hc send"), Edge("hc", "agent", "types reply"), Edge("mod", "web", "curl, links")]
bigSteps = [DiagramStep("The agent writes a file", "It writes OpenUI Lang into `review.oui`.", ["agent>oui"]), DiagramStep("It checks the file", "`opengpui check` parses it exactly as the pane will, using the core library's headless build.", ["agent>cli", "cli>core"]), DiagramStep("It opens the pane", "`opengpui show` empties the events log and asks herdr-core to split a pane with the opengpui mod.", ["cli>events", "cli>hc", "hc>mod"]), DiagramStep("The pane draws", "The mod reads the file; the core library parses it and draws native elements.", ["mod>oui", "mod>core"]), DiagramStep("You answer", "You fill the form and click.", ["person>mod"]), DiagramStep("Your answer goes back", "The mod appends the event to the log and herdr-core types it into the agent's terminal.", ["mod>events", "mod>hc", "hc>agent"]), DiagramStep("The agent carries on", "It reads the reply (or `opengpui wait`), rewrites the file, and the pane redraws, keeping what you typed.", ["cli>events", "agent>oui"])]
bigNote = TextCallout("neutral", "Also on the map", "The mod reaches the web only for images (curl) and links. The skill teaches the agent this loop.")

paneTitle = InlineHeader("How a file becomes pixels")
paneIntro = MarkDownRenderer("The mod is thin; the work happens in the core library, which never imports Herdr.")
pane = Diagram(paneNodes, paneEdges, paneSteps, "right")
paneNodes = [modg, coreg, disk, Node("hc", "herdr-core", "process", "hc send"), Node("web", "Web", "external")]
modg = Group("modg", "Herdr mod (herdr/src)", [Node("main", "main.ts", "module", "view per pane"), Node("theme", "theme.ts", "module", "Herdr theme to tokens"), Node("icons", "icons.ts", "module", "writes SVGs"), Node("images", "images.ts", "module", "local or curl"), Node("contract", "contract.ts", "module", "event shape, path"), Node("demo", "demo.ts", "module", "page without a file"), Node("shared", "shared.js", "module", "lang-core, remark, d3, icons")])
coreg = Group("coreg", "Core library (src/)", [Node("session", "runtime/", "module", "Session"), Node("surface", "render/", "module", "Surface, tokens"), Node("components", "components/", "module", "86 renderers, charts"), Node("markdown", "markdown/", "module", "remark, Prism"), Node("library", "library.ts", "module", "openui, chat"), Node("upstream", "upstream/", "module", "no React, no DOM")])
disk = Group("disk", "Files on disk", [Node("oui", "review.oui", "file"), Node("events", "Events log", "store"), Node("iconcache", "Icon cache", "store"), Node("imagecache", "Image cache", "store")])
paneEdges = [Edge("main", "oui", "reads, watches"), Edge("main", "session", "parses"), Edge("session", "shared", "lang-core"), Edge("session", "library", "components"), Edge("main", "surface", "draws"), Edge("surface", "session", "reads state"), Edge("surface", "components", "renders"), Edge("components", "markdown", "text"), Edge("components", "upstream", "shims"), Edge("main", "theme", "look"), Edge("main", "icons", "icon writer"), Edge("main", "images", "image loader"), Edge("icons", "iconcache", "writes"), Edge("images", "imagecache", "caches"), Edge("images", "web", "curl"), Edge("main", "contract", "event shape"), Edge("main", "events", "appends"), Edge("main", "hc", "hc send"), Edge("main", "demo", "no file")]
paneSteps = [DiagramStep("The view reads the file", "`main.ts` watches the file's folder and re-reads it on change.", ["main>oui"]), DiagramStep("Session parses it", "The runtime parses with lang-core (shipped in `shared.js`) against the OpenUI library.", ["main>session", "session>shared", "session>library"]), DiagramStep("Surface draws", "It draws the session with gpui-kit as retained views and redraws only what changed.", ["main>surface", "surface>session"]), DiagramStep("Components and markdown", "One renderer per OpenUI component; charts are vector paths; markdown goes through unified/remark.", ["surface>components", "components>markdown"]), DiagramStep("Theme, icons, images", "Colors come from the Herdr theme; icons are written as SVG files on first use; images load locally or through curl.", ["main>theme", "main>icons", "main>images", "icons>iconcache", "images>imagecache", "images>web"]), DiagramStep("A click becomes an event", "The session runs the action; the event takes the shape `contract.ts` defines and goes to the log and to `hc send`.", ["session", "main>contract", "main>events", "main>hc"])]
paneNote = TextCallout("neutral", "Also on the map", "`upstream/` shims let upstream's code compile without React; `demo.ts` is the page without a file.")

shipTitle = InlineHeader("From pinned upstream to the gallery")
shipIntro = MarkDownRenderer("Nothing here runs on your machine except the files it ships.")
ship = Diagram(shipNodes, shipEdges, shipSteps, "right")
shipNodes = [dev, gh, Node("tarball", "opengpui-v*.tar.gz", "file"), Node("openui_up", "OpenUI upstream", "external"), Node("assets_up", "Inter, lucide, fontTools", "external"), Node("gallery", "herdr.dev gallery", "external"), Node("install", "Your agent installs", "actor", "into Herdr mods/")]
dev = Group("dev", "Developer machine (scripts/)", [Node("pins", "upstream.json", "file", "pins"), Node("sync", "sync.ts", "process"), Node("upstream_dir", ".upstream/", "store", "OpenUI, Inter, lucide"), Node("types", "types/", "store", "gpui + herdr"), Node("build", "build.ts", "process", "Bun.build"), Node("plugin", "upstream-plugin.ts", "module", "no React"), Node("modfolder", "mods/opengpui/", "store", "main, shared, fonts, CLI"), Node("dist", "dist/", "store", "library builds"), Node("release", "release.ts", "process"), Node("devinstall", "install.ts", "process", "local Herdr")])
gh = Group("gh", "GitHub", [Node("galleryfolder", "gallery/opengpui/", "store", "on main"), Node("ci", "Actions CI", "process", "check, test, release"), Node("ghrelease", "GitHub Release", "external")])
shipEdges = [Edge("pins", "sync", "pins"), Edge("sync", "openui_up", "git checkout"), Edge("sync", "assets_up", "fetch, cut fonts"), Edge("sync", "upstream_dir", "writes"), Edge("sync", "types", "herdr-app types"), Edge("upstream_dir", "build", "sources"), Edge("build", "plugin", "uses"), Edge("build", "modfolder", "main/shared split"), Edge("build", "dist", "libraries"), Edge("modfolder", "release", "assembled"), Edge("release", "tarball", "packs"), Edge("release", "galleryfolder", "copies"), Edge("ci", "ghrelease", "v* tag"), Edge("tarball", "ghrelease", "asset"), Edge("ci", "galleryfolder", "commits"), Edge("galleryfolder", "gallery", "topic herdr-mod"), Edge("gallery", "install", "RECIPE.md"), Edge("modfolder", "devinstall", "dev install")]
shipSteps = [DiagramStep("Pin", "`upstream.json` pins OpenUI, Inter, lucide and fontTools.", ["pins>sync"]), DiagramStep("Sync", "`sync.ts` fetches them into `.upstream/` and gets types from Herdr.", ["sync>openui_up", "sync>assets_up", "sync>upstream_dir", "sync>types"]), DiagramStep("Build", "`build.ts` with `upstream-plugin.ts` compiles upstream without React and splits the mod into main.js and shared.js; it also builds the CLI and `dist/`.", ["upstream_dir>build", "build>plugin", "build>modfolder", "build>dist"]), DiagramStep("Release", "`release.ts` assembles the mod folder into a tarball and the gallery folder.", ["modfolder>release", "release>tarball", "release>galleryfolder"]), DiagramStep("Tag", "On a `v*` tag CI publishes the GitHub Release and commits the gallery folder.", ["ci>ghrelease", "ci>galleryfolder", "tarball>ghrelease"]), DiagramStep("Gallery and install", "herdr.dev lists the mod; your agent copies it into Herdr.", ["galleryfolder>gallery", "gallery>install"])]
shipNote = TextCallout("neutral", "Also on the map", "`install.ts` puts a local build into Herdr for development.")
