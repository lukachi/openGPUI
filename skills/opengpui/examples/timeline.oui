root = Stack([header, roadmap])
header = CardHeader("Q1 roadmap", "Tasks on a time axis, by lane; arrows are dependencies, diamonds milestones.")
roadmap = Timeline(tasks, roadmapSteps)
tasks = [Task("spec", "Spec", "2027-01-04", "2027-01-15", "Design", null, "done"), Task("api", "Build the API", "2027-01-18", "2027-02-12", "Backend", ["spec"], "active"), Task("ui", "Build the UI", "2027-01-25", "2027-02-26", "Frontend", ["spec"]), Task("beta", "Beta", "2027-03-01", null, "Release", ["api", "ui"]), Task("fixes", "Beta fixes", "2027-03-01", "2027-03-19", "Backend", ["beta"]), Task("launch", "Launch", "2027-03-22", null, "Release", ["fixes"])]
roadmapSteps = [DiagramStep("Design first", "The spec is done.", ["spec"]), DiagramStep("Build in parallel", "API and UI start once the spec lands.", ["api", "ui"]), DiagramStep("Ship", "Beta, a round of fixes, then launch.", ["beta", "fixes", "launch"])]
