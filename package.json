{
  "name": "opengpui",
  "version": "0.1.0",
  "private": true,
  "description": "OpenUI Lang rendered with native gpui-kit elements",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync-upstream.ts && bun scripts/assets.ts && bun scripts/sync-types.ts",
    "typecheck": "tsc -p . && tsc -p scripts",
    "build": "bun scripts/build.ts",
    "test": "bun scripts/build.ts && bun test",
    "check": "bun run typecheck && bun run build && herdr-app check herdr/mods/opengpui",
    "install-herdr": "bun scripts/build.ts && bun scripts/install-herdr.ts"
  },
  "dependencies": {
    "html-url-attributes": "3.0.1",
    "react-syntax-highlighter": "16.1.1",
    "refractor": "5.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@openuidev/lang-core": "1.1.0",
    "@types/bun": "^1.4.4",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
